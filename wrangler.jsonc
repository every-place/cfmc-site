// Cloudflare Workers (static assets) config. Cloudflare's dashboard builds with
// `npm run build` and deploys with `npx wrangler deploy`, which serves ./dist.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cfmc-site",
  "compatibility_date": "2026-11-01",
  // Serves the site on the real domain. Cloudflare creates the DNS records for these
  // automatically on deploy (the zone is on the same Cloudflare account).
  "routes": [
    { "pattern": "caringformycaregivers.com", "custom_domain": true },
    { "pattern": "www.caringformycaregivers.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
