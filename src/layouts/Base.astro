---
import '../styles/global.css';
import site from '../data/site.json';

interface Props { title?: string; description?: string; image?: string; }
const { title, description = site.tagline, image = '/images/logo.jpg' } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.name;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Kristen' },
  { href: '/stories', label: 'Grandma Rose & Lily' },
  { href: '/blog', label: 'Blog' },
  { href: '/resources', label: 'Resources' },
  { href: '/contact', label: 'Contact' },
];
const isCurrent = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
const canonical = new URL(Astro.url.pathname, Astro.site);
const socials = [
  { url: site.facebookUrl, label: 'Facebook' },
  { url: site.youtubeUrl, label: 'YouTube' },
  { url: site.instagramUrl, label: 'Instagram' },
].filter((s) => s.url);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} blog`} href="/rss.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#fbf1ce" />
    {site.comingSoon && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@500;600&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    {site.comingSoon ? (
    <main id="main" class="coming-soon">
      <div class="container narrow">
        <img src="/images/logo.jpg" alt="Caring for My Caregivers logo" width="200" height="200" />
        <p class="eyebrow">Coming soon</p>
        <h1>A place of support for dementia and Alzheimer's caregivers</h1>
        <p class="lead">Kristen Dean is building a home for encouragement, practical tips, activity ideas, and trusted resources for families caring for a loved one with memory loss. We'll be open soon.</p>
        {site.contactEmail && (
          <p><a class="btn" href={`mailto:${site.contactEmail}`}>Email {site.contactEmail}</a></p>
        )}
        <div class="note">
          <p><strong>Caregiver, if you're struggling, you don't have to carry it alone.</strong> In the U.S., call or text <strong>988</strong> any time, or call the Alzheimer's Association 24/7 Helpline at <strong style="white-space:nowrap">1-800-272-3900</strong>.</p>
        </div>
      </div>
    </main>
    ) : (<>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/">
          <img src="/images/logo.jpg" alt="" width="56" height="56" />
          <span>{site.name}</span>
        </a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
        <nav class="nav" id="site-nav" aria-label="Main">
          {links.map((l) => <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>)}
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div>
          <strong>{site.name}</strong>
          <small>Support and encouragement for dementia and Alzheimer's caregivers.</small>
          <small>&copy; {new Date().getFullYear()} {site.author}. All rights reserved.</small>
        </div>
        <nav aria-label="Footer">
          {links.slice(1).map((l) => <a href={l.href}>{l.label}</a>)}
          {socials.map((s) => <a href={s.url} rel="noopener">{s.label}</a>)}
        </nav>
      </div>
    </footer>
    <script>
      const btn = document.querySelector('.menu-toggle');
      const nav = document.getElementById('site-nav');
      btn?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(!!open));
      });
    </script>
    </>)}
  </body>
</html>
