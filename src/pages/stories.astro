---
import Base from '../layouts/Base.astro';
const scenes = [
  { src: '/images/stories/making-cookies.jpg', alt: 'Grandma Rose and Lily making cookies together in a cozy kitchen', caption: 'Baking cookies, even when Grandma forgets a step.' },
  { src: '/images/stories/in-the-garden.jpg', alt: 'Grandma Rose handing Lily a pink rose in the garden', caption: 'Sharing roses in Grandma\'s garden.' },
  { src: '/images/stories/bench-sunset-hug.jpg', alt: 'Lily hugging Grandma Rose on a garden bench at sunset', caption: 'A hug at sunset says what words can\'t.' },
  { src: '/images/stories/rose-field-bench-1.jpg', alt: 'Grandma Rose and Lily sitting together on a bench in a field of roses', caption: 'Quiet time together in the rose field.' },
];
---
<Base title="Grandma Rose & Lily" description="Gentle stories about Grandma Rose and her granddaughter Lily that help families talk with children about dementia." image="/images/stories/book-cover-grandma-remembers-jesus.jpg">
  <section class="story-hero" style="background-image:url('/images/stories/rose-field-wide.jpg')">
    <div class="container narrow">
      <h1>The Adventures of Grandma Rose &amp; Lily</h1>
      <p class="lead">Gentle stories about love, family, and memory loss, made for parents and children to share.</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <p>Grandma Rose loves her granddaughter Lily more than anything. Sometimes she forgets an ingredient in the cookie recipe, or that the cookies are still in the oven. When Lily asks, "What's wrong with Grandma?", her mom helps her understand, gently and honestly.</p>
      <p>These short stories give parents words to use when explaining Alzheimer's and dementia to their children, and give children a way to keep loving the grandparent in front of them.</p>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="gallery">
        {scenes.map((s) => (
          <figure>
            <img src={s.src} alt={s.alt} loading="lazy" width="900" height="1350" />
            <figcaption>{s.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split">
        <img class="rounded" src="/images/stories/book-cover-grandma-remembers-jesus.jpg" alt="Book cover: Grandma Remembers Jesus, by Kristen Dean" width="647" height="928" loading="lazy" style="max-width:360px;margin:0 auto" />
        <div>
          <p class="eyebrow">The book</p>
          <h2 style="margin-top:0">Grandma Remembers Jesus</h2>
          <p><em>A Gentle Story of Alzheimer's, Family, and God's Unforgettable Love</em>, by Kristen Dean.</p>
          <p>Even as Grandma Rose's memory fades, Lily discovers that some things are written on the heart. A tender picture book for families walking through Alzheimer's together.</p>
          <p class="meta">Details on where to get the book are coming soon.</p>
        </div>
      </div>
    </div>
  </section>
</Base>
